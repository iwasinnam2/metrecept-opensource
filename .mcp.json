{
  "mcpServers": {
    "metrecept": {
      "command": "ohm-mcp",
      "env": {
        "OHM_API_KEY": "${OHM_API_KEY}",
        "OHM_UPSTREAM_KEY": "${OHM_UPSTREAM_KEY}",
        "OHM_BASE_URL": "${OHM_BASE_URL}"
      }
    },
    "metrecept-hosted": {
      "type": "http",
      "url": "https://api.metrecept.co.uk/mcp"
    }
  }
}
